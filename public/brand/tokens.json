{
  "$description": "mlz brand tokens — the single source for colour, type, shape and motion. Format: W3C Design Tokens (DTCG). Edit the OKLCH components here and run `bun run brand`; it fills in the hex values and regenerates tokens.css, tailwind.css, brand.json and the colour table in BRAND.md.",
  "$extensions": {
    "no.mlz": { "version": "1.0.0", "homepage": "https://mlz.no/brand/" }
  },
  "color": {
    "$type": "color",
    "light": {
      "bg": {
        "$description": "Page background.",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.95, 0.006, 250],
          "hex": "#ebeff2"
        }
      },
      "fg": {
        "$description": "Primary text, the logo mark, button borders.",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.18, 0.006, 250],
          "hex": "#101214"
        },
        "$extensions": { "no.mlz": { "text": true } }
      },
      "fg-secondary": {
        "$description": "Secondary text: eyebrows, footers, captions.",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.36, 0.006, 250],
          "hex": "#3b3d40"
        },
        "$extensions": { "no.mlz": { "text": true } }
      },
      "fg-muted": {
        "$description": "Quiet UI: icon buttons at rest, hints.",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.49, 0.01, 250],
          "hex": "#5c6166"
        },
        "$extensions": { "no.mlz": { "text": true } }
      },
      "border": {
        "$description": "Hairlines and dividers. Decorative, not for text.",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.85, 0.008, 250],
          "hex": "#caced3"
        }
      },
      "accent": {
        "$description": "Decorative violet: selection tint, glitch shadows. Never for text in light.",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.7, 0.16, 285],
          "hex": "#968dfd"
        }
      },
      "accent-deep": {
        "$description": "Violet for text-weight accents: the period in “mlz.”, separators, hover shadows, focus rings.",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.44, 0.12, 285],
          "hex": "#4d4691"
        },
        "$extensions": { "no.mlz": { "text": true } }
      },
      "glitch-2": {
        "$description": "Warm counterpart to accent, only in the glitch effect.",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.58, 0.17, 40],
          "hex": "#c94c18"
        }
      }
    },
    "dark": {
      "bg": {
        "$description": "Page background.",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.2, 0.006, 265],
          "hex": "#151619"
        }
      },
      "fg": {
        "$description": "Primary text, the logo mark, button borders.",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.94, 0.006, 265],
          "hex": "#e9ebef"
        },
        "$extensions": { "no.mlz": { "text": true } }
      },
      "fg-secondary": {
        "$description": "Secondary text: eyebrows, footers, captions.",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.78, 0.006, 265],
          "hex": "#b5b7bb"
        },
        "$extensions": { "no.mlz": { "text": true } }
      },
      "fg-muted": {
        "$description": "Quiet UI: icon buttons at rest, hints.",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.66, 0.01, 265],
          "hex": "#8f9299"
        },
        "$extensions": { "no.mlz": { "text": true } }
      },
      "border": {
        "$description": "Hairlines and dividers. Decorative, not for text.",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.31, 0.008, 265],
          "hex": "#2e3034"
        }
      },
      "accent": {
        "$description": "Decorative violet: selection tint, glitch shadows.",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.7, 0.16, 285],
          "hex": "#968dfd"
        }
      },
      "accent-deep": {
        "$description": "Violet for text-weight accents: the period in “mlz.”, separators, hover shadows, focus rings.",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.74, 0.16, 285],
          "hex": "#a29aff"
        },
        "$extensions": { "no.mlz": { "text": true } }
      },
      "glitch-2": {
        "$description": "Warm counterpart to accent, only in the glitch effect.",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.68, 0.17, 40],
          "hex": "#ec6d3d"
        }
      }
    }
  },
  "font": {
    "$type": "fontFamily",
    "display": {
      "$description": "Names and headlines only. Always italic, weight 500, font-variation-settings \"opsz\" 72.",
      "$value": ["Newsreader", "Georgia", "Times New Roman", "serif"],
      "$extensions": {
        "no.mlz": {
          "faces": [
            {
              "file": "newsreader-italic-variable.woff2",
              "style": "italic",
              "weight": "200 800"
            }
          ]
        }
      }
    },
    "mono": {
      "$description": "Everything else: body, labels, buttons, the “mlz.” wordmark (700).",
      "$value": [
        "IBM Plex Mono",
        "ui-monospace",
        "SFMono-Regular",
        "Menlo",
        "Consolas",
        "monospace"
      ],
      "$extensions": {
        "no.mlz": {
          "faces": [
            {
              "file": "ibm-plex-mono-400.woff2",
              "style": "normal",
              "weight": "400"
            },
            {
              "file": "ibm-plex-mono-700.woff2",
              "style": "normal",
              "weight": "700"
            }
          ]
        }
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Corner radius for buttons and boxes.",
    "$value": { "value": 4, "unit": "px" }
  },
  "ease": {
    "$type": "cubicBezier",
    "$description": "The one easing curve, for every transition and entrance.",
    "$value": [0.2, 0.7, 0.2, 1]
  }
}
