# Response headers for the Cloudflare Workers static-assets deployment. Vite
# copies public/ to the dist root verbatim, so this file ships as dist/_headers,
# where Cloudflare consumes it. It is never itself servable — requests to
# /_headers return 404.
#
# This deployment has no server: the Worker has no `main`, so no code runs per
# request. Security hardening and cache policy therefore can't live in code —
# this file is the only place to apply them. Cloudflare already sets ETag and
# `Cache-Control: public, max-age=0, must-revalidate` on HTML and compresses
# responses, so that isn't repeated here; what remains is the hardening headers
# plus the cache policy for fingerprinted and stable-URL assets.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; img-src 'self' data:; font-src 'self'; style-src 'self'; script-src 'self' https://cloud.umami.is; connect-src 'self' https://cloud.umami.is; manifest-src 'self'; upgrade-insecure-requests

# Vite emits content-hashed filenames here (build.assetsDir), so a changed file
# is a changed URL and these can be cached permanently.
/bundle/*
  Cache-Control: public, max-age=31536000, immutable

# Favicons, social cards and the manifest keep stable URLs across deploys, so
# they get a day of caching rather than immutability — otherwise replacing a
# favicon would never reach anyone who had already loaded the old one.
/assets/*
  Cache-Control: public, max-age=86400

# favicon.ico stays at the well-known root URL that browsers and crawlers request
# automatically, so it can't move under /assets/ — but it's stable across
# deploys, so give it the same day of caching.
/favicon.ico
  Cache-Control: public, max-age=86400
