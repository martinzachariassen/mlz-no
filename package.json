{
  "name": "mlz-no",
  "version": "1.0.0",
  "private": true,
  "description": "Personal homepage for Martin Zachariassen: a static site served from Firebase Hosting, no build step.",
  "homepage": "https://mlz.no",
  "author": "Martin Zachariassen <hi@mlz.no>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martinzachariassen/mlz-no.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "firebase emulators:start --only hosting",
    "build:content": "bun scripts/content/build-content.js",
    "check:content": "bun scripts/content/build-content.js --check",
    "test": "bun test scripts",
    "format": "biome check --write .",
    "lint": "biome ci . && bun run test && bun run check:content"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "firebase-tools": "^15.29.0",
    "zod": "^4.6.2"
  }
}
