{
  // Make the editor format with Biome — the same engine CI runs via `biome ci`
  // (see biome.json). Without this, save-formatting uses a different formatter
  // (or none), so code can reach CI unformatted and fail the lint gate.
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "biomejs.biome",

  // On save, also organize imports and apply Biome's safe fixes, so a save is
  // equivalent to `biome check --write` on that file.
  "editor.codeActionsOnSave": {
    "source.organizeImports.biome": "explicit",
    "quickfix.biome": "explicit"
  },

  // Pin Biome as the formatter per language so it wins over any global default
  // (e.g. Prettier) a contributor may have configured.
  "[typescript]": { "editor.defaultFormatter": "biomejs.biome" },
  "[typescriptreact]": { "editor.defaultFormatter": "biomejs.biome" },
  "[javascript]": { "editor.defaultFormatter": "biomejs.biome" },
  "[javascriptreact]": { "editor.defaultFormatter": "biomejs.biome" }
}
