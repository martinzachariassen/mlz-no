{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mlz-no",
  "compatibility_date": "2026-07-01",

  // Keep both *.workers.dev URLs off. These must live here, not in the
  // dashboard — a `wrangler deploy` re-enables anything toggled off in the UI.
  // Separate switches: the first covers the production URL, the second the
  // per-branch preview URLs.
  "workers_dev": false,
  "preview_urls": false,

  // Static-assets-only Worker: no `main` entrypoint, so dist/ is served straight
  // from the edge and no JavaScript runs per request. Security headers and cache
  // policy live in public/_headers, which Vite copies to the dist root at build.
  "assets": {
    "directory": "./dist",
    // No client-side router here, so an unknown path must return a real 404.
    // "404-page" serves dist/404.html with a 404 status; switch to "none" if
    // that file is ever removed from the build.
    "not_found_handling": "404-page"
  },

  // Persist the observability settings configured in the Cloudflare dashboard so
  // a `wrangler deploy` keeps them consistent across deployments instead of
  // reverting to account defaults. This is a static-assets-only Worker (no
  // `main`), so these take effect only if a Worker handler is ever added — but
  // keeping them in version control is harmless and future-proofs that. The
  // nested `logs.enabled` overrides the top-level `enabled: false`, so
  // invocation logs are still collected once a handler exists.
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },

  // Bind the apex domain in version control so it survives a rebuild from
  // scratch. Wrangler reconciles this list on deploy — any custom domain not
  // listed here gets removed. www is deliberately absent: the redirect rule
  // catches it at the edge, so it never reaches the Worker.
  "routes": [{ "pattern": "mlz.no", "custom_domain": true }]
}
