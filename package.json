{
  "name": "mlz-no",
  "version": "1.0.0",
  "private": true,
  "description": "Personal homepage for Martin Zachariassen — a Vite + React app served as static assets from Firebase Hosting.",
  "homepage": "https://mlz.no",
  "author": "Martin Zachariassen <hi@mlz.no>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martinzachariassen/mlz-no.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "preview:hosting": "firebase emulators:start --only hosting",
    "deploy": "firebase deploy --only hosting",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "format": "biome check --write .",
    "lint": "biome ci ."
  },
  "dependencies": {
    "@martinzachariassen/design": "github:martinzachariassen/mlz-design#v0.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "firebase-tools": "^15.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
